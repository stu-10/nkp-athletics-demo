# Rename to ingress.yaml and add it to kustomization.yaml resources after
# confirming your ingress controller, DNS and TLS secret.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: cloud-native-games
spec:
  ingressClassName: REPLACE_INGRESS_CLASS
  tls:
    - hosts: [games.example.com]
      secretName: games-tls
  rules:
    - host: games.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: cloud-native-games
                port:
                  name: http
